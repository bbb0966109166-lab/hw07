   /* 全域與基本排版設定 */
body {
    font-family: "Microsoft JhengHei", Arial, sans-serif;
    line-height: 1.6;
    color: #333;
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    background-color: #fcfbfa;
}

header {
    text-align: center;
    padding: 20px 0;
}

h1, h2, h3 {
    color: #5c4033; /* 沉穩的木質色系，呼應日式官舍風格 */
}

section {
    margin-bottom: 30px;
    background: #fff;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th, td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: left;
}

th {
    background-color: #f2ebe1;
    color: #5c4033;
}

figure {
    text-align: center;
    margin: 20px 0;
}

figure img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
}

figcaption {
    font-size: 0.9em;
    color: #666;
    margin-top: 8px;
}

.media-aspect-ratio {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 比例 */
    height: 0;
}

.media-aspect-ratio iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
}

footer {
    text-align: center;
    font-size: 0.85em;
    color: #777;
    margin-top: 40px;
    padding: 20px 0;
    border-top: 1px solid #ddd;
}
